# Speech-to-text provider (DMXAPI gpt-4o-transcribe)
# Create backend/.env from this file and replace the placeholder with your DMXAPI Key.
SPEECH_TRANSCRIBE_API_KEY=sk-your-dmxapi-key
SPEECH_TRANSCRIBE_MODEL=gpt-4o-transcribe
SPEECH_TRANSCRIBE_BASE_URL=https://www.dmxapi.cn/v1/audio/transcriptions
# DMXAPI requires the raw key in Authorization, without the Bearer prefix.
SPEECH_TRANSCRIBE_AUTH_SCHEME=raw
SPEECH_TRANSCRIBE_TIMEOUT_SECONDS=90
# auto preserves the language that was spoken. Set en or zh only when a fixed
# recognition language is required for a particular deployment.
SPEECH_TRANSCRIBE_DEFAULT_LANGUAGE=auto
# The current GPT STT line can be re-enabled by setting this to false. Qwen Omni
# is enabled by default because it accepts browser-recorded audio reliably.
SPEECH_TRANSCRIBE_USE_FALLBACK_AS_PRIMARY=true
SPEECH_TRANSCRIBE_FALLBACK_ENABLED=true
SPEECH_TRANSCRIBE_FALLBACK_MODEL=qwen3-omni-flash-all
SPEECH_TRANSCRIBE_FALLBACK_BASE_URL=https://www.dmxapi.cn/v1/responses
SPEECH_TRANSCRIBE_FALLBACK_TIMEOUT_SECONDS=45
# Convert browser-recorded WebM to WAV before uploading. This avoids providers
# whose audio-duration meter cannot parse WebM metadata.
SPEECH_TRANSCRIBE_CONVERT_WEBM_TO_WAV=true
SPEECH_TRANSCRIBE_FFMPEG_BIN=ffmpeg
SPEECH_TRANSCRIBE_FFMPEG_TIMEOUT_SECONDS=30

# Domain hotwords are read from backend/speech_glossary.json by default. The file
# supports canonical spellings, aliases, category and priority; see the example.
SPEECH_GLOSSARY_MAX_PROMPT_TERMS=80
SPEECH_GLOSSARY_MAX_PROMPT_CHARS=1600
